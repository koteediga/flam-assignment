# Copy this file to .env and fill in your own key. Never commit the real .env.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Any model OpenRouter supports that's decent at following JSON instructions.
# Free-tier friendly options: "meta-llama/llama-3.1-8b-instruct:free",
# "google/gemma-2-9b-it:free". Paid but cheap: "openai/gpt-4o-mini".
MODEL=meta-llama/llama-3.1-8b-instruct:free

PORT=8787
